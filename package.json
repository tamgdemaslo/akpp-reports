{
  "name": "akpp-generator",
  "version": "1.0.0",
  "description": "AKPP Generator - Генератор отчетов по замене масла в АКПП",
  "main": "server.js",
  "scripts": {
    "start": "PORT=8080 node server.js",
    "dev": "PORT=8080 nodemon --ignore \"gearbox_files/gearbox_index.js\" server.js",
    "proxy": "node proxy-server.js",
    "serve": "PORT=8080 node serve.js",
    "dev:live": "LIVE_RELOAD=1 npm run dev",
    "build-gearbox-bundle": "node build_gearbox_bundle.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamgdemaslo/akpp-reports.git"
  },
  "author": "AKPP Generator",
  "license": "MIT"
}
